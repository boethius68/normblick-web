ErrorDocument 404 /404.html
AddType application/x-apple-diskimage .dmg

# Eine Adresse je Seite: www und /index.html auf die kanonische URL.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.normblick\.luneq\.eu$ [NC]
RewriteRule ^ https://normblick.luneq.eu%{REQUEST_URI} [R=301,L]
# Nur ausdrücklich angefragtes /index.html, nicht den internen DirectoryIndex.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Assets tragen einen Inhalts-Hash als ?v=… (scripts/check-asset-versions.py).
  <FilesMatch "\.(css|js|webp|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
